architecture-beta
  group cycle(server)[QVN Folding Chamber]
  service enable(server)[Prime QVN] in cycle
  service capture(server)[Gather :: 5-cycle sweeps] in cycle
  service changes(database)[qvn.segment_VT] in cycle
  service consumer(internet)[Observer ZEN request] in cycle
  service cleanup(server)[Release :: 3-span keeping] in cycle
  service watermark(disk)[Advance release ZEN] in cycle

  enable:B --> T:capture
  capture:B --> T:changes
  changes:B --> T:consumer
  consumer:B --> T:cleanup
  cleanup:B --> T:watermark
