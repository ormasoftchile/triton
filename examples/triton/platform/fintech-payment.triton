platform "Fintech Payment & Settlement Platform"
  figure "FIGURE 06 · MULTI-RAIL CLEARING MESH"
  desc "Resilient multi-rail payment engine handling tokenization, real-time ML fraud scoring, and idempotent ledger settlement across global banking rails."

  legend
    square auth "Authorization" #3b82f6
    circle settlement "Cleared & Settled" #10b981
    diamond audit "Compliance & Audit" #8b5cf6
  end

  tier channels "MERCHANT CHANNELS"
    card pos "Smart POS" [EMV / Tap to Pay] @icon:lightning
    card ecom "Checkout SDK" [Web & Mobile] @icon:globe
    card billing "Recurring Subscriptions" [Scheduled Cron] @icon:server
  end

  tier core "PAYMENT SWITCH & CLEARING"
    box switch "Transaction Switch" [Zero-Downtime Settlement Engine]
      grid 2
        card token "Token Vault" [PCI-DSS Card Storage]
        card fraud "Fraud AI" [ML Risk Scoring <10ms]
        card auth3ds "3D Secure 2.0" [Strong Customer Auth]
        card routing "Least-Cost Router" [Interchange Optimization]
      end
      card gateway "Switchboard Gateway" [Idempotency & Replay Protection]
    end

    box clearing "Settlement Networks" [Downstream Clearing Rails]
      branch
        card fednow "FedNow Instant" @icon:cloud
        card visa "Visa Direct" @icon:lightning
        card sepa "SEPA Instant" @icon:globe
      end
    end
  end

  tier persistence "IMMUTABLE LEDGER & AUDIT"
    card ledger "CockroachDB" [Double-Entry Ledger] @icon:database
    card audit_bus "Kafka Audit Log" [WORM Compliance Stream] @icon:queue
    card hsm "Cloud HSM" [Hardware Key Store] @icon:shield
  end

  bus channels -->|"ISO 8583 / REST"| switch.gateway @anim:stream
  bus switch.gateway -->|"FedNow & Card Rails"| clearing @anim:particle
  bus switch.gateway -->|"mTLS / Double-Entry"| persistence @anim:stream
  bus clearing --> fednow, visa, sepa
