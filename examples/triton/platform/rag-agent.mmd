platform "Agentic AI & Retrieval Platform"
  figure "FIGURE 04 · MULTI-AGENT INFERENCE ARCHITECTURE"
  desc "Low-latency inference pipeline orchestrating intent classification, tool execution via MCP, and hybrid vector retrieval for enterprise reasoning agents."

  legend
    square prompt "User Prompt / Intent" #3b82f6
    circle tool "Tool Execution (MCP)" #10b981
    diamond context "Retrieved Context" #8b5cf6
  end

  tier clients "USER CHANNELS"
    card web "Web Copilot" [Streaming UI] @icon:globe
    card ide "IDE Coding Agent" [Language Server Protocol] @icon:robot
    card slack "ChatOps Bot" [Enterprise Webhooks] @icon:api
  end

  tier orchestrator "AGENT REASONING CORE"
    box engine "Cognitive Engine" [Autonomous Reasoning Loop]
      grid 2
        card guard "Prompt Guardrails" [Injection & PII Filter]
        card memory "Session Memory" [Conversation Window]
        card intent "Intent Classifier" [Semantic Router]
        card eval "Factuality & Eval" [Grounding Check]
      end
      card planner "ReAct Planner" [Autonomous Task Decomposition]
    end
  end

  tier tools "TOOL EXECUTION (MCP)"
    card sandbox "Python Sandbox" [Isolated Docker Runtime] @icon:robot
    card search "Web Search MCP" [Live Web Scraping] @icon:globe
    card sql "SQL Analytics Engine" [Read-Only Database] @icon:database
    card git "GitHub API Tool" [Repository Context] @icon:api
  end

  tier models "MODELS & KNOWLEDGE FABRIC"
    card llm "Frontier LLM Cluster" [Reasoning & Tool Use] @icon:openai
    card qdrant "Qdrant Vector DB" [Hybrid Dense/Sparse Search] @icon:database
    card graph "Neo4j Knowledge Graph" [Entity Ontology] @icon:cloud
    card valkey "Valkey KV Store" [Checkpoint Cache] @icon:lightning
  end

  bus clients -->|"Prompts & Context"| engine.planner @anim:stream
  bus engine.planner -->|"Tool Execution (MCP)"| tools @anim:particle
  bus tools -->|"Inference & Embeddings"| models @anim:stream
