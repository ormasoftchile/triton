platform "Real-Time Data Lakehouse & Streaming Pipeline"
  figure "FIGURE 05 · MEDALLION LAKEHOUSE TOPOLOGY"
  desc "High-throughput streaming ETL decoupling high-velocity event producers from real-time analytics and BI consumption."

  legend
    square raw "Raw Ingestion" #3b82f6
    circle cleaned "Cleaned / Enriched" #10b981
    diamond olap "Real-Time Queries" #8b5cf6
  end

  tier sources "INGESTION SOURCES"
    card telemetry "IoT Sensors" [MQTT · Telemetry] @icon:robot
    card cdc "Database CDC" [Postgres Debezium] @icon:database
    card webhooks "Partner Webhooks" [REST Ingress] @icon:api
  end

  tier buffer "EVENT INGESTION BUFFER"
    card kafka "Apache Kafka" [Partitioned Distributed Log] @icon:queue
    card schema "Schema Registry" [Avro · Protobuf Governance] @icon:shield
  end

  tier compute "STREAM & BATCH COMPUTE"
    card flink "Apache Flink" [Sub-Second Stateful Aggregation] @icon:lightning
    card spark "Apache Spark" [Micro-Batch Transformations] @icon:cloud
  end

  tier lakehouse "LAKEHOUSE & SERVING"
    card iceberg "Apache Iceberg" [ACID Medallion Tables] @icon:storage
    card clickhouse "ClickHouse OLAP" [Sub-Second Real-Time Mart] @icon:lightning
    card snowflake "Snowflake" [Enterprise Warehouse & BI] @icon:cloud
  end

  bus sources -->|"MQTT & Webhooks"| buffer @anim:stream
  bus buffer -->|"Kafka Consumer Groups"| compute @anim:stream
  bus compute -->|"Parquet / ACID Commits"| lakehouse @anim:flow
